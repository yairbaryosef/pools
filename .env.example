ATLAS_ENV=development
ATLAS_DATABASE_URL=sqlite:///database/atlas-dev.sqlite3
ATLAS_FIREBASE_PROJECT_ID=replace-before-use
GOOGLE_APPLICATION_CREDENTIALS=
ATLAS_LOG_LEVEL=INFO
ATLAS_GOOGLE_CLIENT_ID=replace-before-use
ATLAS_GOOGLE_CLIENT_SECRET=replace-before-use
ATLAS_GOOGLE_ISSUER=https://accounts.google.com
ATLAS_GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
ATLAS_SESSION_COOKIE_NAME=atlas_session
ATLAS_FRONTEND_ORIGIN=http://127.0.0.1:8000
